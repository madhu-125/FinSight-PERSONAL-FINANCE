SERVER_PORT=8080
CLIENT_ORIGIN=http://localhost:3000
DEMO_AUTH_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/finsight?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace_with_your_mysql_password
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=FinSight <verified-sender@your-domain.com>
# Alternatively, configure SMTP. For Gmail, use smtp.gmail.com on port 587
# with a Google App Password (not your normal Gmail password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_AUTH=true
SMTP_STARTTLS=true
OTP_SECRET=replace_with_a_random_secret_at_least_32_characters_long
OTP_CONSOLE_DELIVERY_ENABLED=false
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
